# Revive backend base URL (FastAPI). The client appends /api/v1.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Stub auth: user id sent as X-User-Id (and as a query param on SSE streams). Backend
# defaults to demo-user; keep in sync so connections and investigations share one user.
NEXT_PUBLIC_USER_ID=demo-user
