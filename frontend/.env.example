# Revive backend base URL (FastAPI). The client appends /api/v1.
#
# Local backend:        http://127.0.0.1:8000
# Shared tunnel backend: https://<name>.trycloudflare.com  (from `docker compose logs cloudflared`)
#
# For a Vercel deploy, set NEXT_PUBLIC_API_BASE in the Vercel project's Environment Variables
# to the backend URL. NEXT_PUBLIC_* is inlined at build time, so a change needs a redeploy.
# The quick-tunnel URL is EPHEMERAL (changes when cloudflared restarts) - for a stable Vercel
# deployment use a NAMED Cloudflare tunnel on your own domain (see docs/DEPLOY.md).
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Stub auth: user id sent as X-User-Id (and as a query param on SSE streams). Backend
# defaults to demo-user; keep in sync so connections and investigations share one user.
NEXT_PUBLIC_USER_ID=demo-user
