# Repo-root env read by docker-compose for ${VAR} interpolation. Copy to .env (gitignored).

# Data source for the containerized backend: seed (deterministic demo) or live.
REVIVE_DATA_SOURCE=seed

# Cloudflare tunnel.
#  - Quick tunnel (default): leave both blank -> random *.trycloudflare.com URL in the logs.
#  - Named tunnel (stable, e.g. https://api.revive.log0.in): create a tunnel in the Cloudflare
#    Zero Trust dashboard, add a Public Hostname (api.revive / log0.in -> http://backend:8000),
#    paste its token below, and set the args to `run`. See docs/DEPLOY.md.
CLOUDFLARE_TUNNEL_ARGS=
CLOUDFLARE_TUNNEL_TOKEN=
