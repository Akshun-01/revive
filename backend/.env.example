# Revive backend local config. Gitignored. Copy from .env.example.

# DATA SOURCE: seed = deterministic fixtures (eval + safe demo); live = upstream MCP.
# In live mode, each provider's MCP endpoint + token come from the user's saved connection
# (base_url + token). Point base_url at an Arga twin - see docs/ARGA-integration.md.
REVIVE_DATA_SOURCE=seed

# LLM token, read directly by huggingface_hub (no REVIVE_ prefix).
# Model + provider use code defaults (meta-llama/Llama-3.1-8B-Instruct); override with
# REVIVE_HF_MODEL / REVIVE_USE_LLM only if needed.
HF_TOKEN=

# LangSmith tracing (read directly by langsmith, no REVIVE_ prefix).
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_PROJECT="revive"

# Postgres (LangGraph checkpoints). Host port 5433 per docker-compose.yml.
REVIVE_DATABASE_URL=postgresql://revive:revive@localhost:5433/revive

# Fernet key encrypting stored per-user connection credentials. Required for `live` mode.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REVIVE_SECRET_KEY=

# NOTE: Stripe/HubSpot/Slack credentials are NOT env vars. Each user supplies their own
# on the frontend; Revive stores them per-user (encrypted) in the connections table.

ARGA_API_KEY=
